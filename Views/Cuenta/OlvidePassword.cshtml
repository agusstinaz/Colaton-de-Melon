@{
    ViewData["Title"] = "Recuperar contraseña";
}

<section class="account-page">

    <div class="account-container">

        <div class="account-header">

            <div class="account-icon">
                🩷
            </div>

            <h1>Recuperar contraseña</h1>

            <p>
                Ingresá el correo electrónico de tu cuenta
                y te enviaremos un enlace para crear una
                nueva contraseña.
            </p>

        </div>

        <form asp-controller="Cuenta"
              asp-action="OlvidePassword"
              method="post"
              class="account-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            <div class="form-group">

                <label for="email">
                    Correo electrónico
                </label>

                <input type="email"
                       id="email"
                       name="email"
                       class="form-control"
                       placeholder="ejemplo@email.com"
                       autocomplete="email"
                       required />

            </div>

            <button type="submit"
                    class="account-btn">
                ENVIAR ENLACE 🩷
            </button>

        </form>

        <div class="account-footer">

            <a asp-controller="Cuenta"
               asp-action="Login"
               class="account-link">
                VOLVER A INICIAR SESIÓN
            </a>

        </div>

    </div>

</section>