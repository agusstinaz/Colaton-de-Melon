@model ColatonDeMelon.Models.CambiarPasswordViewModel

@{
    ViewData["Title"] = "Cambiar contraseña";
}

<section class="account-page">

    <div class="account-container">

        <div class="account-header">

            <div class="account-icon">
                🔐
            </div>

            <h1>Cambiar contraseña</h1>

            <p>
                Actualizá la contraseña de tu cuenta
                de Colatón de Melón.
            </p>

        </div>


        <form asp-controller="Cuenta"
              asp-action="CambiarPassword"
              method="post"
              class="account-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <!-- CONTRASEÑA ACTUAL -->

            <div class="form-group">

                <label asp-for="PasswordActual">
                    Contraseña actual
                </label>

                <input asp-for="PasswordActual"
                       class="form-control"
                       autocomplete="current-password"
                       placeholder="Ingresá tu contraseña actual" />

                <span asp-validation-for="PasswordActual"
                      class="text-danger">
                </span>

            </div>


            <!-- NUEVA CONTRASEÑA -->

            <div class="form-group">

                <label asp-for="NuevaPassword">
                    Nueva contraseña
                </label>

                <input asp-for="NuevaPassword"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Ingresá tu nueva contraseña" />

                <span asp-validation-for="NuevaPassword"
                      class="text-danger">
                </span>

            </div>


            <!-- CONFIRMAR CONTRASEÑA -->

            <div class="form-group">

                <label asp-for="ConfirmarPassword">
                    Confirmar nueva contraseña
                </label>

                <input asp-for="ConfirmarPassword"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Repetí tu nueva contraseña" />

                <span asp-validation-for="ConfirmarPassword"
                      class="text-danger">
                </span>

            </div>


            <button type="submit"
                    class="account-btn">

                CAMBIAR CONTRASEÑA 🔐

            </button>

        </form>


        <div class="account-footer">

            <a asp-controller="Cuenta"
               asp-action="MiCuenta"
               class="account-link">

                ← VOLVER A MI CUENTA

            </a>

        </div>

    </div>

</section>