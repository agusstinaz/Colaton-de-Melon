@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="account-page">

    <div class="account-container">

        <div class="account-header">

            <div class="account-icon">
                🩷
            </div>

            <h1>Iniciar sesión</h1>

            <p>
                Ingresá a tu cuenta de Colatón de Melón
                para continuar con tu compra.
            </p>

        </div>

        <form asp-controller="Cuenta"
              asp-action="Login"
              method="post"
              class="account-form">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="returnUrl"
                   value="@ViewBag.ReturnUrl" />

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            <!-- EMAIL -->

            <div class="form-group">

                <label for="email">
                    Correo electrónico
                </label>

                <input type="email"
                       id="email"
                       name="email"
                       class="form-control"
                       placeholder="ejemplo@email.com"
                       autocomplete="email"
                       required />

            </div>

            <!-- CONTRASEÑA -->

            <div class="form-group">

                <label for="password">
                    Contraseña
                </label>

                <input type="password"
                       id="password"
                       name="password"
                       class="form-control"
                       placeholder="Ingresá tu contraseña"
                       autocomplete="current-password"
                       required />

            </div>
            <!-- RECORDAR -->

            <div class="login-options">

                <label class="remember-label">

                    <input type="checkbox"
                           name="recordar"
                           value="true" />

                    <span>
                        Recordarme
                    </span>

                </label>

                <a asp-controller="Cuenta"
                   asp-action="OlvidePassword"
                   class="forgot-password-link">
                    ¿Olvidaste tu contraseña?
                </a>

            </div>
            <!-- BOTÓN -->

            <button type="submit"
                    class="account-btn">
                INICIAR SESIÓN 🩷
            </button>

        </form>

        <div class="account-footer">

            <p>
                ¿Todavía no tenés una cuenta?
            </p>

            <a asp-controller="Cuenta"
               asp-action="Registro"
               class="account-link">
                CREAR MI CUENTA
            </a>

        </div>

    </div>

</section>