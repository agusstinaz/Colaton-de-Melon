@model ColatonDeMelon.Models.Producto

@{
    ViewData["Title"] = "Nuevo producto";
}

<section class="admin-product-form-page">

    ```
    <div class="admin-product-form-header">
        <span>ADMINISTRACIÓN</span>

        <h1>Nuevo producto</h1>

        <p>
            Agregá un producto a la tienda.
        </p>
    </div>


    <form asp-action="Crear"
          method="post"
          enctype="multipart/form-data"
          class="admin-product-form">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>


        <div class="admin-form-group">

            <label asp-for="Nombre">
                Nombre del producto
            </label>

            <input asp-for="Nombre"
                   class="admin-form-input" />

            <span asp-validation-for="Nombre"
                  class="validation-message">
            </span>

        </div>


        <div class="admin-form-group">

            <label asp-for="Descripcion">
                Descripción
            </label>

            <textarea asp-for="Descripcion"
                      class="admin-form-input"
                      rows="4"></textarea>

            <span asp-validation-for="Descripcion"
                  class="validation-message">
            </span>

        </div>


        <div class="admin-form-group">

            <label asp-for="Precio">
                Precio
            </label>

            <input asp-for="Precio"
                   class="admin-form-input"
                   type="number"
                   step="0.01"
                   min="0" />

            <span asp-validation-for="Precio"
                  class="validation-message">
            </span>

        </div>


        <div class="admin-form-group">

            <label asp-for="Stock">
                Stock
            </label>

            <input asp-for="Stock"
                   class="admin-form-input"
                   type="number"
                   min="0" />

            <span asp-validation-for="Stock"
                  class="validation-message">
            </span>

        </div>


        <div class="admin-form-group">

            <label>
                Imagen del producto
            </label>

            <input type="file"
                   name="imagenArchivo"
                   class="admin-form-input"
                   accept="image/*" />

            <small>
                Podés seleccionar una imagen desde tu computadora,
                celular o tablet.
            </small>

        </div>


        <div class="admin-form-group">

            <label asp-for="IdEdad">
                Edad
            </label>

            <select asp-for="IdEdad"
                    class="admin-form-input">

                <option value="">
                    Seleccionar edad
                </option>

                @foreach (var edad in ViewBag.Edades)
                {
                    <option value="@edad.IdEdad">
                        @edad.Nombre
                    </option>
                }

            </select>

            <span asp-validation-for="IdEdad"
                  class="validation-message">
            </span>

        </div>


        <div class="admin-form-group">

            <label asp-for="IdTipoPrenda">
                Tipo de ropa
            </label>

            <select asp-for="IdTipoPrenda"
                    class="admin-form-input">

                <option value="">
                    Seleccionar tipo de ropa
                </option>

                @foreach (var tipo in ViewBag.TiposPrenda)
                {
                    <option value="@tipo.IdTipoPrenda">
                        @tipo.Nombre
                    </option>
                }

            </select>

            <span asp-validation-for="IdTipoPrenda"
                  class="validation-message">
            </span>

        </div>


        <input type="hidden"
               asp-for="IdCategoria"
               value="1" />


        <div class="admin-form-actions">

            <button type="submit"
                    class="admin-form-button primary">
                GUARDAR PRODUCTO
            </button>

            <a asp-action="Index"
               class="admin-form-button secondary">
                CANCELAR
            </a>

        </div>

    </form>
    ```

</section>

@section Scripts {

    ```
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
    ```

}
