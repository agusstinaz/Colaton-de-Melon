@model ColatonDeMelon.Models.Producto

@{
    ViewData["Title"] = Model.Nombre;
}

<section class="product-detail">

    ```
    <div class="product-detail-image">

        @if (!string.IsNullOrWhiteSpace(Model.Imagen))
        {
            <img src="~/images/productos/@Model.Imagen"
                 alt="@Model.Nombre" />
        }
        else
        {
            <div class="product-detail-no-image">
                SIN IMAGEN
            </div>
        }

    </div>


    <div class="product-detail-info">

        <span class="product-category">
            @if (Model.TipoPrenda != null)
            {
                @Model.TipoPrenda.Nombre
            }
        </span>

        <h1>
            @Model.Nombre
        </h1>

        @if (Model.Edad != null)
        {
            <p class="product-detail-age">
                @Model.Edad.Nombre
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
        {
            <p class="detail-description">
                @Model.Descripcion
            </p>
        }

        <p class="detail-price">
            $@Model.Precio.ToString("N0")
        </p>

        <div class="detail-stock">

            @if (Model.Stock > 0)
            {
                <span class="detail-stock-available">
                    Disponible
                </span>
            }
            else
            {
                <span class="detail-stock-unavailable">
                    Sin stock
                </span>
            }

        </div>


        @if (Model.Stock > 0)
        {
            <form asp-controller="Carrito"
                  asp-action="Agregar"
                  method="post"
                  class="product-detail-cart-form">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.IdProducto" />

                <button type="submit"
                        class="btn-primary">
                    AGREGAR AL CARRITO
                </button>

            </form>
        }

        <a asp-controller="Productos"
           asp-action="Index"
           class="product-detail-back">
            ← VOLVER A PRODUCTOS
        </a>

    </div>
    ```

</section>
