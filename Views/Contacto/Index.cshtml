@{
    ViewData["Title"] = "Contacto";
}

<section class="contact-page">

    <div class="contact-header">
        <span class="contact-kicker">💕 ESTAMOS PARA VOS</span>

        <h1>Contactate con nosotros</h1>

        <p>
            ¿Tenés alguna consulta sobre nuestros productos,
            pedidos o formas de pago?
            ¡Estamos para ayudarte!
        </p>
    </div>

    <div class="contact-content">

        <!-- MAPA -->
        <div class="contact-map-card">

            <div class="contact-section-title">
                <span>📍</span>
                <div>
                    <h2>Visitá nuestro local</h2>
                    <p>
                        Policías de los Territorios Nacionales 1160
                    </p>
                    <span>Formosa Capital, Argentina</span>
                </div>
            </div>

            <div class="contact-map">
                <iframe src="https://www.google.com/maps?q=Policías+de+los+Territorios+Nacionales+1160,+Formosa,+Argentina&output=embed"
                
                        height="420"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>

            <a href="https://maps.app.goo.gl/8u3xtMzMdwMXCRsW8"
               target="_blank"
               rel="noopener noreferrer"
               class="contact-map-button">
                🗺️ VER UBICACIÓN EN GOOGLE MAPS
            </a>

        </div>


        <!-- FORMAS DE CONTACTO -->
        <div class="contact-info-card">

            <h2>Encontranos también en 💗</h2>

            <div class="contact-links">

                <!-- WHATSAPP -->
                <a href="https://wa.me/549370479224"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="contact-link whatsapp-contact">

                    <div class="contact-link-icon">
                        💬
                    </div>

                    <div class="contact-link-info">
                        <strong>WhatsApp</strong>
                        <span>+54 370 404-5223</span>
                        <small>Escribinos directamente</small>
                    </div>

                    <span class="contact-link-arrow">→</span>

                </a>


                <!-- INSTAGRAM -->
                <a href="https://www.instagram.com/colatondemelon/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="contact-link instagram-contact">

                    <div class="contact-link-icon">
                        📸
                    </div>

                    <div class="contact-link-info">
                        <strong>Instagram</strong>
                        <span>colatondemelon</span>
                        <small>Seguinos en Instagram</small>
                    </div>

                    <span class="contact-link-arrow">→</span>

                </a>


                <!-- FACEBOOK -->
                <a href="https://www.facebook.com/colatondemelonn?locale=es_LA"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="contact-link facebook-contact">

                    <div class="contact-link-icon">
                        📘
                    </div>

                    <div class="contact-link-info">
                        <strong>Facebook</strong>
                        <span>Colatón de Melón</span>
                        <small>Visitá nuestra página</small>
                    </div>

                    <span class="contact-link-arrow">→</span>

                </a>

            </div>

        </div>

    </div>


    <!-- MENSAJE FINAL -->
    <div class="contact-bottom-message">

        <div class="contact-bottom-icon">
            🧸
        </div>

        <div>
            <h2>¡Estamos para ayudarte!</h2>

            <p>
                Podés escribirnos por WhatsApp o encontrarnos
                en nuestras redes sociales.
                Será un placer atenderte. 💕
            </p>
        </div>

    </div>

</section>